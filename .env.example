# PhishLab Production Environment Variables Template (Vercel + Neon + Upstash + Blob)
# Copy this file to .env for local testing or configure these in Vercel Project -> Settings -> Environment Variables

FLASK_ENV=production
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-256bit
SESSION_EPOCH=2
BASE_URL=https://phishlab-nine.vercel.app

# Neon PostgreSQL (or leave unset locally to use SQLite database/phishlab.db)
DATABASE_URL=postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin authentication (prefer ADMIN_PASSWORD_HASH generated via werkzeug.security.generate_password_hash)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$replace-with-werkzeug-password-hash

# Upstash Redis REST (do NOT pass this URL to redis.from_url)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Vercel Blob Private Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_with_token

SESSION_COOKIE_SECURE=True
