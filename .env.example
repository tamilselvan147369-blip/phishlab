# PhishLab Production Environment Variables Template
# Copy this file to .env for local testing or configure these in Render Dashboard -> Environment

FLASK_ENV=production
SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-256bit
DATABASE_URL=postgresql://phishlab_user:password@hostname:5432/phishlab
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongPasswordHere2026!
UPLOAD_FOLDER=/var/data/demonstration_uploads
PORT=10000
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
SESSION_COOKIE_SECURE=True
